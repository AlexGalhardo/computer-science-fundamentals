{
	"name": "software-engineer-fundamentals",
	"private": true,
	"type": "module",
	"workspaces": [
		"benchmarks",
		"quiz",
		"tools/*"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit -p quiz && tsc --noEmit -p tools/bench && tsc --noEmit -p tools/scaffold && tsc --noEmit -p benchmarks",
		"quiz:validate": "bun run quiz/scripts/validate.ts",
		"quiz:blind": "bun run quiz/scripts/blind.ts",
		"quiz:compare": "bun run quiz/scripts/compare.ts",
		"bench": "bun run tools/bench/src/cli.ts",
		"new:project": "bun run tools/scaffold/src/cli.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"typescript": "7.0.2"
	}
}

{
	"name": "computer-science-fundamentals",
	"private": true,
	"type": "module",
	"workspaces": [
		"benchmarks",
		"quiz",
		"tools/*"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"lint:md": "markdownlint-cli2",
		"format:md": "markdownlint-cli2 --fix",
		"typecheck": "tsc --noEmit -p quiz && tsc --noEmit -p tools/bench && tsc --noEmit -p tools/scaffold && tsc --noEmit -p benchmarks",
		"quiz:validate": "bun run quiz/scripts/validate.ts",
		"quiz:blind": "bun run quiz/scripts/blind.ts",
		"quiz:compare": "bun run quiz/scripts/compare.ts",
		"bench": "bun run tools/bench/src/cli.ts",
		"new:project": "bun run tools/scaffold/src/cli.ts",
		"docs:index": "bun run quiz/scripts/status.ts",
		"dashboard:css": "bun run tools/scaffold/src/css.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"markdownlint-cli2": "0.23.3",
		"typescript": "7.0.2"
	},
	"overrides": {
		"playwright-core": "1.63.0"
	}
}

{
	"project": "counter-race",
	"runs": 5,
	"warmup": 1,
	"sizes": [1000000],
	"variants": ["1", "2", "4", "8"],
	"targets": [
		{
			"language": "go",
			"dockerfile": "go/Dockerfile",
			"version": "go version",
			"implementations": ["buggy", "mutex", "atomic", "channel"],
			"command": "env WORKERS={variant} counter-race-go {implementation} {n}"
		},
		{
			"language": "rust",
			"dockerfile": "rust/Dockerfile",
			"version": "rustc --version",
			"implementations": ["buggy", "mutex", "atomic", "channel"],
			"command": "env WORKERS={variant} counter-race-rust {implementation} {n}"
		},
		{
			"language": "java",
			"dockerfile": "java/Dockerfile",
			"version": "java --version",
			"implementations": ["buggy", "mutex", "atomic", "queue"],
			"command": "env WORKERS={variant} counter-race-java {implementation} {n}"
		},
		{
			"language": "ts",
			"dockerfile": "ts/Dockerfile",
			"version": "bun --version",
			"implementations": ["buggy", "mutex", "atomic", "message"],
			"command": "env WORKERS={variant} counter-race-ts {implementation} {n}"
		},
		{
			"language": "elixir",
			"dockerfile": "elixir/Dockerfile",
			"version": "elixir --short-version",
			"implementations": ["get-then-set", "actor"],
			"command": "env WORKERS={variant} counter-race-elixir {implementation} {n}"
		}
	]
}

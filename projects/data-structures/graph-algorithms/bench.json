{
	"project": "graph-algorithms",
	"runs": 5,
	"warmup": 1,
	"sizes": [1000, 4000],
	"targets": [
		{
			"language": "cpp",
			"image": "gcc:16.2.0-trixie",
			"version": "g++ --version",
			"build": "g++ -std=c++23 -O2 cpp/bench.cpp -o .bench/graph_bench_cpp",
			"implementations": [
				"dijkstra-list",
				"dijkstra-matrix",
				"bellman-ford-list",
				"prim-list",
				"prim-matrix",
				"kruskal-list",
				"toposort-list"
			],
			"command": ".bench/graph_bench_cpp {implementation} {n}"
		},
		{
			"language": "go",
			"image": "golang:1.27.1-bookworm",
			"version": "go version",
			"build": "cd go && go build -o ../.bench/graph_bench_go ./cmd/bench",
			"implementations": [
				"dijkstra-list",
				"dijkstra-matrix",
				"bellman-ford-list",
				"prim-list",
				"prim-matrix",
				"kruskal-list",
				"toposort-list"
			],
			"command": ".bench/graph_bench_go {implementation} {n}"
		}
	]
}

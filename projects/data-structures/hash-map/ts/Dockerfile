# EN: Bun on a pinned image is runtime and test runner. There are no dependencies to install.
# PT: O Bun em uma imagem fixada é runtime e executor de testes. Não há dependências para instalar.
# ES: Bun en una imagen fijada es el runtime y el ejecutor de pruebas. No hay dependencias que instalar.
FROM oven/bun:1.4.2
WORKDIR /app
COPY . .
CMD ["bun", "test"]

{
	"project": "hash-map",
	"runs": 5,
	"warmup": 1,
	"sizes": [200000],
	"variants": ["0.25", "0.5", "0.75", "0.9"],
	"targets": [
		{
			"language": "cpp",
			"image": "gcc:16.2.0-trixie",
			"version": "g++ --version",
			"build": "g++ -std=c++23 -O2 cpp/bench.cpp -o .bench/hash_map_bench",
			"implementations": ["chaining", "probing"],
			"command": ".bench/hash_map_bench {implementation} {n} {variant}"
		},
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --quiet --manifest-path rust/Cargo.toml --target-dir .bench/rust",
			"implementations": ["chaining", "probing"],
			"command": ".bench/rust/release/bench {implementation} {n} {variant}"
		},
		{
			"language": "ts",
			"image": "oven/bun:1.4.2",
			"version": "bun --version",
			"implementations": ["chaining", "probing"],
			"command": "bun run ts/bench.ts {implementation} {n} {variant}"
		}
	]
}

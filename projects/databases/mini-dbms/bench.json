{
	"project": "mini-dbms",
	"runs": 3,
	"warmup": 1,
	"sizes": [1000, 10000, 100000, 1000000],
	"maxN": { "nested-loop": 10000 },
	"targets": [
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --quiet --manifest-path rust/Cargo.toml",
			"implementations": ["nested-loop", "hash", "sort-merge"],
			"command": "rust/target/release/mini-dbms bench {implementation} {n}"
		},
		{
			"language": "python",
			"image": "python:3.14.8-slim-trixie",
			"version": "python --version",
			"implementations": ["nested-loop", "hash", "sort-merge"],
			"command": "python python/bench.py {implementation} {n}"
		}
	]
}

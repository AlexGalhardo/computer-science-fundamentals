// EN: The Prisma view of the tables created by sql/schema.sql. `@map` and `@@map` connect the
//     camelCase names used in TypeScript to the snake_case names used in the database.
// PT: A visão do Prisma das tabelas criadas por sql/schema.sql. `@map` e `@@map` ligam os nomes
//     camelCase usados no TypeScript aos nomes snake_case usados no banco.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Author {
  id      Int    @id @default(autoincrement())
  name    String
  country String
  posts   Post[]

  @@map("authors")
}

model Post {
  id        Int       @id @default(autoincrement())
  authorId  Int       @map("author_id")
  title     String
  views     Int       @default(0)
  published Boolean   @default(false)
  author    Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([authorId], map: "posts_author_id_idx")
  @@map("posts")
}

model Comment {
  id     Int    @id @default(autoincrement())
  postId Int    @map("post_id")
  body   String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "comments_post_id_idx")
  @@map("comments")
}

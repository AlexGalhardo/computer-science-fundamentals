{
	"project": "dynamic-programming",
	"runs": 3,
	"warmup": 1,
	"sizes": [8, 12, 16, 20, 100, 500],
	"maxN": { "knapsack-naive": 20, "lcs-naive": 12, "coins-naive": 20 },
	"targets": [
		{
			"language": "ts",
			"image": "oven/bun:1.4.2",
			"version": "bun --version",
			"implementations": [
				"knapsack-naive",
				"knapsack-memo",
				"knapsack-tab",
				"lcs-naive",
				"lcs-memo",
				"lcs-tab",
				"coins-naive",
				"coins-memo",
				"coins-tab"
			],
			"command": "bun run ts/src/bench.ts {implementation} {n}"
		},
		{
			"language": "python",
			"image": "python:3.14.8-slim-trixie",
			"version": "python --version",
			"implementations": [
				"knapsack-naive",
				"knapsack-memo",
				"knapsack-tab",
				"lcs-naive",
				"lcs-memo",
				"lcs-tab",
				"coins-naive",
				"coins-memo",
				"coins-tab"
			],
			"command": "python python/bench.py {implementation} {n}"
		}
	]
}

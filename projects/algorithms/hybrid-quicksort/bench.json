{
	"project": "hybrid-quicksort",
	"runs": 3,
	"warmup": 1,
	"sizes": [4000, 16000, 1000000],
	"variants": ["random", "sorted", "reversed"],
	"maxN": { "first-k0": 16000 },
	"targets": [
		{
			"language": "cpp",
			"image": "gcc:16.2.0-trixie",
			"version": "g++ --version",
			"build": "mkdir -p cpp/build && g++ -std=c++23 -O2 cpp/main.cpp -o cpp/build/bench",
			"implementations": [
				"first-k0",
				"random-k0",
				"median3-k0",
				"median3-k5",
				"median3-k10",
				"median3-k20",
				"median3-k50"
			],
			"command": "cpp/build/bench {implementation} {variant} {n}"
		},
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --offline --manifest-path rust/Cargo.toml",
			"implementations": [
				"first-k0",
				"random-k0",
				"median3-k0",
				"median3-k5",
				"median3-k10",
				"median3-k20",
				"median3-k50"
			],
			"command": "rust/target/release/hybrid-quicksort {implementation} {variant} {n}"
		}
	]
}

{
	"project": "sorting-race",
	"runs": 3,
	"warmup": 1,
	"sizes": [1000, 2000, 10000, 100000, 200000],
	"variants": ["random"],
	"maxN": { "bubble": 10000, "insertion": 10000 },
	"targets": [
		{
			"language": "ts",
			"image": "oven/bun:1.4.2",
			"version": "bun --version",
			"build": "bun run ts/src/generate.ts 1000 2000 10000 100000 200000",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "bun run ts/src/bench.ts {implementation} {variant} {n}"
		},
		{
			"language": "cpp",
			"image": "gcc:16.2.0-trixie",
			"version": "g++ --version",
			"build": "mkdir -p cpp/build && g++ -std=c++23 -O2 cpp/bench.cpp -o cpp/build/bench",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "cpp/build/bench {implementation} {variant} {n}"
		},
		{
			"language": "python",
			"image": "python:3.14.8-slim-trixie",
			"version": "python --version",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "python python/bench.py {implementation} {variant} {n}"
		},
		{
			"language": "java",
			"image": "eclipse-temurin:25.0.4.1_1-jdk-noble",
			"version": "java --version",
			"build": "javac -d java/out java/Sorts.java java/Bench.java",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "java -cp java/out Bench {implementation} {variant} {n}"
		},
		{
			"language": "elixir",
			"image": "elixir:1.20.4-otp-28-slim",
			"version": "elixir --short-version",
			"build": "cd elixir && MIX_ENV=prod mix compile",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "elixir -pa elixir/_build/prod/lib/sorting_race/ebin -e \"SortingRace.Bench.main(System.argv())\" -- {implementation} {variant} {n}"
		},
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --offline --manifest-path rust/Cargo.toml",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "rust/target/release/sorting-race {implementation} {variant} {n}"
		},
		{
			"language": "go",
			"image": "golang:1.27.1-bookworm",
			"version": "go version",
			"build": "cd go && go build -buildvcs=false -o bin/bench .",
			"implementations": ["bubble", "insertion", "merge", "quick", "heap", "radix"],
			"command": "go/bin/bench {implementation} {variant} {n}"
		}
	]
}

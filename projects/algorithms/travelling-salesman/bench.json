{
	"project": "travelling-salesman",
	"runs": 3,
	"warmup": 0,
	"sizes": [6, 8, 10, 11, 12, 13, 14, 16, 18, 20, 100],
	"maxN": { "brute-force": 14, "held-karp": 20 },
	"targets": [
		{
			"language": "ts",
			"image": "oven/bun:1.4.2",
			"version": "bun --version",
			"implementations": ["brute-force", "held-karp", "nearest-neighbour", "two-opt"],
			"command": "bun run ts/src/bench.ts {implementation} {n}"
		},
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --offline --manifest-path rust/Cargo.toml",
			"implementations": ["brute-force", "held-karp", "nearest-neighbour", "two-opt"],
			"command": "rust/target/release/travelling-salesman {implementation} {n}"
		}
	]
}

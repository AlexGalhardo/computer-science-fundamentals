// EN: Demonstration change. The code is correct, but rustfmt would spread it over three lines.
// PT: Mudança de demonstração. O código está correto, mas o rustfmt o dividiria em três linhas.
// ES: Cambio de demostración. El código es correcto, pero rustfmt lo repartiría en tres líneas.
pub fn total(prices:&[i64])->i64{prices.iter().sum()}

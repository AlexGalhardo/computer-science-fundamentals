		"pt": {
			"statement": "Qual é a complexidade de tempo da busca binária em um vetor ordenado de n elementos?",
			"alternatives": [
				"O(1)",
				"O(log n)",
				"O(n)",
				"O(n log n)"
			],
			"explanations": [
				"O(1) exigiria achar o elemento sem depender do tamanho do vetor, o que só acontece no melhor caso.",
				"Cada comparação descarta metade do intervalo, então bastam cerca de log₂ n passos.",
				"O(n) é o custo da busca sequencial, que não aproveita a ordenação.",
				"O(n log n) é o custo típico de ordenar, não de buscar em dados já ordenados."
			],
			"concept": "A busca binária compara o alvo com o elemento do meio e continua só na metade que ainda pode conter o alvo. O intervalo cai de n para n/2, n/4 e assim por diante, até sobrar um elemento."
		},
		"en": {
			"statement": "What is the time complexity of binary search on a sorted array of n elements?",
			"alternatives": [
				"O(1)",
				"O(log n)",
				"O(n)",
				"O(n log n)"
			],
			"explanations": [
				"O(1) would mean finding the element without depending on the array size, which only happens in the best case.",
				"Each comparison discards half of the interval, so about log₂ n steps are enough.",
				"O(n) is the cost of sequential search, which ignores the ordering.",
				"O(n log n) is the typical cost of sorting, not of searching data that is already sorted."
			],
			"concept": "Binary search compares the target with the middle element and continues only in the half that can still hold it. The interval shrinks from n to n/2, n/4 and so on, until one element is left."
		},
		"es": {
			"statement": "¿Cuál es la complejidad temporal de la búsqueda binaria en un arreglo ordenado de n elementos?",
			"alternatives": [
				"O(1)",
				"O(log n)",
				"O(n)",
				"O(n log n)"
			],
			"explanations": [
				"O(1) significaría encontrar el elemento sin depender del tamaño del arreglo, lo que solo ocurre en el mejor caso.",
				"Cada comparación descarta la mitad del intervalo, así que bastan unos log₂ n pasos.",
				"O(n) es el costo de la búsqueda secuencial, que no aprovecha el orden.",
				"O(n log n) es el costo típico de ordenar, no de buscar en datos ya ordenados."

{
	"project": "external-sorting",
	"runs": 7,
	"warmup": 1,
	"sizes": [250000, 1000000],
	"variants": ["run-1024k", "run-4096k", "run-16384k"],
	"targets": [
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --offline --manifest-path rust/Cargo.toml",
			"implementations": ["fanin-2", "fanin-4", "fanin-16", "fanin-64"],
			"command": "rust/target/release/extsort bench {implementation} {variant} {n}"
		},
		{
			"language": "go",
			"image": "golang:1.27.1-bookworm",
			"version": "go version",
			"build": "cd go && go build -buildvcs=false -o bin/extsort .",
			"implementations": ["fanin-2", "fanin-4", "fanin-16", "fanin-64"],
			"command": "go/bin/extsort bench {implementation} {variant} {n}"
		}
	]
}

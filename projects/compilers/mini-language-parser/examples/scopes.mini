// Scopes: a block opens a new scope; an inner `let` shadows the outer name.
let x = "global";
{
	let x = "outer block";
	{
		let x = "inner block";
		print x;
	}
	print x;
}
print x;
fn show() {
	print x;
}
{
	let x = "caller block";
	show();
}
let count = 0;
{
	count = count + 1;
	let count = 100;
	count = count + 1;
	print count;
}
print count;

// Closures: a function remembers the variables of the place where it was defined.
fn makeCounter() {
	let count = 0;
	fn increment() {
		count = count + 1;
		return count;
	}
	return increment;
}
let first = makeCounter();
let second = makeCounter();
print first();
print first();
print second();
print first();
fn makeAdder(n) {
	fn adder(x) {
		return x + n;
	}
	return adder;
}
let addFive = makeAdder(5);
print addFive(10);
print makeAdder(1)(2);
fn twice(f, x) {
	return f(f(x));
}
print twice(addFive, 0);

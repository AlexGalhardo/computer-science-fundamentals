{
	"project": "regex-engine",
	"runs": 3,
	"warmup": 1,
	"sizes": [10, 15, 20, 25, 1000, 100000, 1000000],
	"maxN": { "backtracking": 25 },
	"targets": [
		{
			"language": "go",
			"image": "golang:1.27.1-bookworm",
			"version": "go version",
			"build": "go build -C go -o ../.bench/regex-engine ./cmd/regex-engine",
			"implementations": ["backtracking", "nfa", "dfa"],
			"command": ".bench/regex-engine bench {implementation} {n}"
		}
	]
}

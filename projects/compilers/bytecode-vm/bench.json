{
	"project": "bytecode-vm",
	"runs": 5,
	"warmup": 1,
	"sizes": [100000, 1000000],
	"targets": [
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --quiet --manifest-path rust/Cargo.toml",
			"implementations": ["loop", "recursion"],
			"command": "rust/target/release/bytecode-vm bench bench/{implementation}.mini {n}"
		},
		{
			"language": "ts",
			"image": "oven/bun:1.4.2",
			"version": "bun --version",
			"implementations": ["loop", "recursion"],
			"command": "bun run baseline-ts/bench.ts bench/{implementation}.mini {n}"
		}
	]
}

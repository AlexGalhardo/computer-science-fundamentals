// Benchmark: a recursive function that makes about 2n calls (a binary tree with the largest
// power of two up to n as its number of leaves). The runner puts `let n = <n>;` in front.
fn leaves(depth) {
	if depth == 0 {
		return 1;
	}
	return leaves(depth - 1) + leaves(depth - 1);
}
let depth = 0;
let width = 1;
while width * 2 <= n {
	width = width * 2;
	depth = depth + 1;
}
print leaves(depth);

{
	"project": "scaling-by-cores",
	"runs": 5,
	"warmup": 1,
	"sizes": [9000000],
	"variants": ["1", "2", "4", "8"],
	"targets": [
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --offline --manifest-path rust/Cargo.toml",
			"implementations": [
				"primes-seq",
				"primes-static",
				"primes-dynamic",
				"mandelbrot-seq",
				"mandelbrot-static",
				"mandelbrot-dynamic"
			],
			"command": "rust/target/release/scaling-by-cores {implementation} {n} {variant}"
		},
		{
			"language": "go",
			"image": "golang:1.27.1-bookworm",
			"version": "go version",
			"build": "cd go && go build -o bin/scaling .",
			"implementations": [
				"primes-seq",
				"primes-static",
				"primes-dynamic",
				"mandelbrot-seq",
				"mandelbrot-static",
				"mandelbrot-dynamic"
			],
			"command": "go/bin/scaling {implementation} {n} {variant}"
		},
		{
			"language": "cpp",
			"image": "gcc:16.2.0-trixie",
			"version": "g++ --version",
			"build": "mkdir -p cpp/build && g++ -std=c++23 -O2 -ffp-contract=off -pthread cpp/main.cpp -o cpp/build/scaling",
			"implementations": [
				"primes-seq",
				"primes-static",
				"primes-dynamic",
				"mandelbrot-seq",
				"mandelbrot-static",
				"mandelbrot-dynamic"
			],
			"command": "cpp/build/scaling {implementation} {n} {variant}"
		}
	]
}

{
	"project": "cache-friendly-matrix",
	"runs": 3,
	"warmup": 1,
	"sizes": [256, 512, 1000, 1024, 1500],
	"variants": ["default"],
	"targets": [
		{
			"language": "cpp",
			"image": "gcc:16.2.0-trixie",
			"version": "g++ --version",
			"build": "mkdir -p cpp/build && g++ -std=c++23 -O3 -ffp-contract=off cpp/main.cpp -o cpp/build/bench",
			"implementations": ["naive", "interchanged", "blocked-32", "blocked-64"],
			"command": "cpp/build/bench {implementation} {n}"
		},
		{
			"language": "rust",
			"image": "rust:1.99.0-slim-trixie",
			"version": "rustc --version",
			"build": "cargo build --release --offline --manifest-path rust/Cargo.toml",
			"implementations": ["naive", "interchanged", "blocked-32", "blocked-64"],
			"command": "rust/target/release/cache-friendly-matrix {implementation} {n}"
		}
	]
}

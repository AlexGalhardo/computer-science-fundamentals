{
	"name": "bun-vs-node",
	"private": true,
	"type": "module",
	"scripts": {
		"start:bun": "bun run src/bun-server.ts",
		"build:node": "bun build src/node-server.ts --target=node --format=cjs --outfile dist/node-server.cjs",
		"test": "bun test tests/unit",
		"test:api": "bun test tests/api",
		"report": "bun run src/report-cli.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"typescript": "7.0.2"
	}
}

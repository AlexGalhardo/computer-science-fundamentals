# EN: A script for msh. Run it with: docker compose run --rm shell-demo
# PT: Um script para o msh. Execute com: docker compose run --rm shell-demo
# ES: Un script para msh. Ejecútalo con: docker compose run --rm shell-demo

echo "1. a pipeline of three processes"
printf 'pear\napple\nfig\napple\npear\napple\n' | sort | uniq -c

echo "2. redirection: > creates the file, >> appends, < reads it back"
printf 'first line\n' > /tmp/msh-demo.txt
echo "second line" >> /tmp/msh-demo.txt
wc -l < /tmp/msh-demo.txt

echo "3. cd is a builtin, so the next command runs in the new directory"
cd /tmp
pwd

echo "4. a reader that exits early ends the whole pipeline"
seq 1 1000000 | head -n 2 | cat

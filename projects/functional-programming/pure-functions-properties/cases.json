{
	"codec": {
		"examples": [["", ""], ["a", "1a"], ["aaabcc", "3a1b2c"], ["abab", "1a1b1a1b"], ["zzzzzzzzz", "9z"]]
	},
	"normalize": {
		"examples": [["  blue   shirt ", "BLUE-SHIRT"], ["Mug", "MUG"], ["a\tb  c", "A-B-C"], ["   ", ""]]
	},
	"checkout": {
		"now": 1000,
		"examples": [
			{
				"name": "no coupon",
				"order": { "items": [{ "unitCents": 1500, "quantity": 2 }], "coupon": null },
				"expected": { "subtotalCents": 3000, "discountCents": 0, "totalCents": 3000 }
			},
			{
				"name": "valid coupon",
				"order": {
					"items": [{ "unitCents": 1500, "quantity": 2 }, { "unitCents": 999, "quantity": 1 }],
					"coupon": { "percent": 10, "expiresAt": 1000 }
				},
				"expected": { "subtotalCents": 3999, "discountCents": 399, "totalCents": 3600 }
			},
			{
				"name": "expired coupon",
				"order": {
					"items": [{ "unitCents": 1500, "quantity": 2 }],
					"coupon": { "percent": 10, "expiresAt": 999 }
				},
				"expected": { "subtotalCents": 3000, "discountCents": 0, "totalCents": 3000 }
			},
			{
				"name": "empty order",
				"order": { "items": [], "coupon": { "percent": 50, "expiresAt": 2000 } },
				"expected": { "subtotalCents": 0, "discountCents": 0, "totalCents": 0 }
			}
		]
	},
	"pipeline": {
		"top": 3,
		"orders": [
			{
				"status": "paid",
				"lines": [
					{ "category": "books", "unitCents": 4000, "quantity": 2 },
					{ "category": "games", "unitCents": 25000, "quantity": 1 }
				]
			},
			{
				"status": "cancelled",
				"lines": [{ "category": "games", "unitCents": 99000, "quantity": 3 }]
			},
			{
				"status": "paid",
				"lines": [
					{ "category": "tools", "unitCents": 6000, "quantity": 1 },
					{ "category": "music", "unitCents": 1500, "quantity": 4 },
					{ "category": "books", "unitCents": 3000, "quantity": 1 }
				]
			},
			{
				"status": "pending",
				"lines": [{ "category": "music", "unitCents": 70000, "quantity": 1 }]
			},
			{
				"status": "paid",
				"lines": [{ "category": "garden", "unitCents": 500, "quantity": 2 }]
			}
		],
		"expected": [
			{ "category": "games", "totalCents": 25000 },
			{ "category": "books", "totalCents": 11000 },
			{ "category": "music", "totalCents": 6000 }
		]
	}
}

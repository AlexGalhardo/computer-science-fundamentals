// EN: markdownlint for every Markdown file of the repository: `bun run lint:md` (check) and
//     `bun run format:md` (fix what can be fixed automatically). CI runs the check.
// PT: markdownlint para todo arquivo Markdown do repositório: `bun run lint:md` (verifica) e
//     `bun run format:md` (corrige o que dá para corrigir sozinho). O CI roda a verificação.
// ES: markdownlint para todo archivo Markdown del repositorio: `bun run lint:md` (verifica) y
//     `bun run format:md` (corrige lo que se puede corregir solo). El CI corre la verificación.
{
	"globs": ["**/*.md"],
	"ignores": [
		"**/node_modules/**",
		// EN: Third-party skills are copied as they are (see .claude/skills/SOURCES.md).
		// PT: As skills de terceiros são copiadas como estão (veja .claude/skills/SOURCES.md).
		// ES: Las skills de terceros se copian tal cual (ver .claude/skills/SOURCES.md).
		".claude/skills/**",
		".claude/worktrees/**",
		// EN: Result tables are written by the benchmark and demo programs, not by hand.
		// PT: As tabelas de resultado são escritas pelos programas de benchmark e demo, não à mão.
		// ES: Las tablas de resultados las escriben los programas de benchmark y demo, no a mano.
		"**/results/**",
		"**/.next/**",
		"**/out/**",
		"**/target/**",
		"**/_build/**",
		"**/deps/**",
		"**/playwright-report/**",
		"**/test-results/**"
	],
	"gitignore": true,
	"config": {
		"default": true,
		// EN: Prose is written one paragraph per line, so there is no line length limit.
		// PT: A prosa é escrita com um parágrafo por linha, então não há limite de largura.
		// ES: La prosa se escribe con un párrafo por línea, así que no hay límite de ancho.
		"MD013": false,
		// EN: The same heading may repeat under different parents ("Added" in each release).
		// PT: O mesmo título pode se repetir sob pais diferentes ("Added" em cada versão).
		// ES: El mismo título puede repetirse bajo padres distintos ("Added" en cada versión).
		"MD024": { "siblings_only": true },
		// EN: .editorconfig is the source of truth and uses tabs, also for nested lists (PLAN.md)
		//     and inside code blocks, so the two rules about tabs and list indent are off.
		// PT: O .editorconfig é a fonte da verdade e usa tabs, também em listas aninhadas (PLAN.md)
		//     e dentro de blocos de código, então as duas regras de tab e recuo de lista ficam desligadas.
		// ES: El .editorconfig es la fuente de verdad y usa tabs, también en listas anidadas (PLAN.md)
		//     y dentro de bloques de código, así que las dos reglas de tab y sangría de lista quedan apagadas.
		"MD010": false,
		"MD007": false,
		// EN: Tables are written compact (`| a | b |`), not padded into aligned columns.
		// PT: As tabelas são escritas compactas (`| a | b |`), sem alinhar as colunas com espaços.
		// ES: Las tablas se escriben compactas (`| a | b |`), sin alinear las columnas con espacios.
		"MD060": false,
		// EN: The root READMEs centre their header with a little HTML.
		// PT: Os READMEs da raiz centralizam o cabeçalho com um pouco de HTML.
		// ES: Los READMEs de la raíz centran su encabezado con un poco de HTML.
		"MD033": { "allowed_elements": ["div", "br", "img", "a", "p", "details", "summary", "sub", "sup", "kbd"] }
	}
}

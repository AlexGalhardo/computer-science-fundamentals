{
	"project": "sample",
	"runs": 3,
	"warmup": 1,
	"sizes": [1000, 100000],
	"targets": [
		{
			"language": "ts",
			"image": "oven/bun:1.4.2",
			"version": "bun --version",
			"implementations": ["sum-loop", "sum-formula"],
			"command": "bun run ts/bench.ts {implementation} {n}"
		},
		{
			"language": "python",
			"image": "python:3.14.8-slim-trixie",
			"version": "python --version",
			"implementations": ["sum-loop", "sum-formula"],
			"command": "python python/bench.py {implementation} {n}"
		}
	]
}

{
	"project": "cpu-single",
	"runs": 5,
	"warmup": 1,
	"sizes": [100000, 1000000, 10000000],
	"maxN": { "nbody": 1000000 },
	"targets": [
		{
			"language": "cpp",
			"dockerfile": "../docker/cpp.Dockerfile",
			"version": "g++ --version",
			"implementations": ["nbody", "sieve"],
			"command": "/opt/bench/main {implementation} {n}"
		},
		{
			"language": "rust",
			"dockerfile": "../docker/rust.Dockerfile",
			"version": "rustc --version",
			"implementations": ["nbody", "sieve"],
			"command": "/opt/bench/main {implementation} {n}"
		},
		{
			"language": "go",
			"dockerfile": "../docker/go.Dockerfile",
			"version": "go version",
			"implementations": ["nbody", "sieve"],
			"command": "/opt/bench/main {implementation} {n}"
		},
		{
			"language": "java",
			"dockerfile": "../docker/java.Dockerfile",
			"version": "java --version",
			"implementations": ["nbody", "sieve"],
			"command": "java -cp /opt/bench Main {implementation} {n}"
		},
		{
			"language": "ts",
			"dockerfile": "../docker/ts.Dockerfile",
			"version": "bun --version",
			"implementations": ["nbody", "sieve"],
			"command": "bun /opt/bench/main.ts {implementation} {n}"
		},
		{
			"language": "elixir",
			"dockerfile": "../docker/elixir.Dockerfile",
			"version": "elixir --short-version",
			"implementations": ["nbody", "sieve"],
			"command": "elixir -pa /opt/bench -e \"Main.main(System.argv())\" {implementation} {n}"
		},
		{
			"language": "python",
			"dockerfile": "../docker/python.Dockerfile",
			"version": "python --version",
			"implementations": ["nbody", "sieve"],
			"command": "python /opt/bench/main.py {implementation} {n}"
		}
	]
}

{
	"name": "benchmarks",
	"private": true,
	"type": "module",
	"scripts": {
		"all": "bun run scripts/run-all.ts",
		"bench": "bun run ../tools/bench/src/cli.ts",
		"images": "bun run scripts/build-images.ts",
		"sections": "bun run scripts/collect-sections.ts",
		"http": "bun run http/collect.ts",
		"build-time": "bun run build-time/collect.ts",
		"binary-size": "bun run binary-size/collect.ts",
		"database": "bun run database/collect.ts",
		"data": "bun run scripts/build-data.ts",
		"build:css": "tailwindcss -i dashboard/input.css -o dashboard/tailwind.css --minify",
		"test": "bun test ./tests/",
		"test:http": "bun test http/suite.test.ts",
		"test:database": "bun test database/suite.test.ts",
		"test:dashboard": "bun run scripts/test-dashboard.ts",
		"typecheck": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.3.3",
		"tailwindcss": "4.3.3"
	}
}

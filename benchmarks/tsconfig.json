{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["bun"]
	},
	"include": [
		"scripts",
		"tests",
		"http/*.ts",
		"http/tests",
		"http/servers/ts",
		"build",
		"binary-size",
		"database/*.ts",
		"database/clients/ts",
		"*/ts"
	]
}

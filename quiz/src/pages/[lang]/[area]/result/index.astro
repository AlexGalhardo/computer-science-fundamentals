---
import { ResultView } from "@/components/ResultView";
import { getDictionary, isLanguage } from "@/i18n";
import { getArea, getQuestions } from "@/lib/content";
import { areaPaths } from "@/lib/paths";
import Language from "../../../../layouts/Language.astro";

export function getStaticPaths(): ReturnType<typeof areaPaths> {
	return areaPaths();
}

const lang = Astro.params.lang;
const slug = Astro.params.area;
if (typeof lang !== "string" || typeof slug !== "string" || !isLanguage(lang)) {
	throw new Error("missing area");
}
if (getArea(slug) === undefined) {
	throw new Error(`unknown area ${slug}`);
}
const dictionary = getDictionary(lang);
---

<Language>
	<ResultView
		client:load
		area={slug}
		questions={getQuestions(slug, lang)}
		language={lang}
		dictionary={dictionary}
	/>
</Language>

---
import { QuizRunner } from "@/components/QuizRunner";
import { getDictionary, isLanguage } from "@/i18n";
import { getArea, getQuestions } from "@/lib/content";
import { areaPaths } from "@/lib/paths";
import Language from "../../../../layouts/Language.astro";

export function getStaticPaths(): ReturnType<typeof areaPaths> {
	return areaPaths();
}

const lang = Astro.params.lang;
const slug = Astro.params.area;
if (typeof lang !== "string" || typeof slug !== "string" || !isLanguage(lang)) {
	throw new Error("missing area");
}
const area = getArea(slug);
if (area === undefined) {
	throw new Error(`unknown area ${slug}`);
}
const dictionary = getDictionary(lang);
---

<Language>
	<!--
		EN: The questions of this area, in this language only, are embedded in the page at build
		    time. The browser never asks a server for them.
		PT: As questões desta área, só neste idioma, são embutidas na página no build. O navegador
		    nunca pede nada a um servidor.
		ES: Las preguntas de esta área, solo en este idioma, se incrustan en la página durante el build.
		    El navegador nunca pide nada a un servidor.
	-->
	<QuizRunner
		client:load
		area={slug}
		areaName={area.name[lang]}
		questions={getQuestions(slug, lang)}
		language={lang}
		dictionary={dictionary}
	/>
</Language>

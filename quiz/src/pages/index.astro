---
import { LANGUAGE_KEY } from "@/i18n";
import { withBase } from "@/lib/navigate";

// EN: A static site has no server to read Accept-Language, so the choice happens in the browser:
//     the saved language wins, then the browser language, then English.
// PT: Um site estático não tem servidor para ler Accept-Language, então a escolha acontece no
//     navegador: vale o idioma salvo, depois o idioma do navegador, depois inglês.
// ES: Un sitio estático no tiene servidor que lea Accept-Language, así que la elección ocurre en
//     el navegador: gana el idioma guardado, luego el del navegador, luego inglés.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const redirectScript = `(function(){var l;try{l=localStorage.getItem(${JSON.stringify(LANGUAGE_KEY)})}catch(e){}if(l!=="pt"&&l!=="en"&&l!=="es"){l=(navigator.language||"en").toLowerCase().slice(0,2);if(l!=="pt"&&l!=="es"){l="en"}}location.replace(${JSON.stringify(base)}+"/"+l+"/")})()`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Computer Science Fundamentals</title>
		<script is:inline set:html={redirectScript} />
	</head>
	<body>
		<main style="font-family: system-ui, sans-serif; padding: 2rem">
			<h1>Computer Science Fundamentals</h1>
			<p>
				<a href={withBase("/en/")}>English</a>
				{" · "}
				<a href={withBase("/pt/")} lang="pt-BR">Português</a>
				{" · "}
				<a href={withBase("/es/")} lang="es">Español</a>
			</p>
		</main>
	</body>
</html>

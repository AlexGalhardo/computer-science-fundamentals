# EN: A plain static file server. Nothing here knows about Next.js: it only serves the files
#     of the `out/` folder, which is the proof that the quiz needs no application server.
# PT: Um servidor de arquivos estáticos simples. Nada aqui conhece o Next.js: ele só serve os
#     arquivos da pasta `out/`, o que prova que o quiz não precisa de servidor de aplicação.
:8080 {
	root * /srv
	encode gzip zstd
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# Trailing double space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# The ecosystems below have a standard formatter that enforces spaces.
# The formatter wins over the repository default (ruff, rustfmt, mix format, google-java-format).
[*.py]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{ex,exs}]
indent_style = space
indent_size = 2

[*.java]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf
